package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

soong_config_module_type {
    name: "libdmabufheap_libion_export_defaults",
    module_type: "cc_defaults",
    config_namespace: "libdmabufheap",
    bool_variables: ["legacy_impl"],
    properties: ["export_static_lib_headers"],
}

libdmabufheap_libion_export_defaults {
    name: "libdmabufheap_libion_export_defaults",
    soong_config_variables: {
        legacy_impl: {
            export_static_lib_headers: [
                "libbase",
                "libion",
            ],
            conditions_default: {
                export_static_lib_headers: ["libbase"],
            },
        },
    },
}

// Keep allocator compatibility independent of libion's backend selection.
// Some vendor blobs still use the old allocator API while libion itself is
// intentionally the upstream stub. A device can preserve that combination:
//
//     $(call soong_config_set_bool,libdmabufheap,legacy_impl,true)
//
// When unset, the ION-free implementation remains the default.
cc_library {
    defaults: ["libdmabufheap_libion_export_defaults"],
    srcs: select(soong_config_variable("libdmabufheap", "legacy_impl"), {
        true: [
            "BufferAllocator_legacy.cpp",
            "BufferAllocatorWrapper_legacy.cpp",
        ],
        default: [
            "BufferAllocator.cpp",
            "BufferAllocatorWrapper.cpp",
        ],
    }),
    name: "libdmabufheap",
    recovery_available: true,
    vendor_available: true,

    // Added because codec2 is double_loadable.
    // See b/147147883, b/147147992
    double_loadable: true,
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
    min_sdk_version: "29",
    cflags: [
        "-Wall",
        "-Werror",
    ],
    local_include_dirs: select(soong_config_variable("libdmabufheap", "legacy_impl"), {
        true: ["include_legacy"],
        default: ["include"],
    }),
    export_include_dirs: select(soong_config_variable("libdmabufheap", "legacy_impl"), {
        true: ["include_legacy"],
        default: ["include"],
    }),
    static_libs: [
        "libbase",
    ] + select(soong_config_variable("libdmabufheap", "legacy_impl"), {
        true: ["libion"],
        default: [],
    }),
    shared_libs: [
        "liblog",
    ],
}

rust_bindgen {
    name: "libdmabufheap_bindings",
    wrapper_src: "include/BufferAllocator/BufferAllocatorWrapper.h",
    crate_name: "dmabufheap_bindings",
    source_stem: "bindings",
    local_include_dirs: ["include"],
    bindgen_flags: [
        "--allowlist-function=CreateDmabufHeapBufferAllocator",
        "--allowlist-function=FreeDmabufHeapBufferAllocator",
        "--allowlist-function=DmabufHeapAlloc2",
        "--allowlist-function=DmabufSetName",
        "--allowlist-function=DmabufHeapAllocSystem2",
        "--allowlist-function=DmabufHeapCpuSyncStart2",
        "--allowlist-function=DmabufHeapCpuSyncEnd2",
        "--allowlist-var=kDmabufSystemHeapName",
        "--allowlist-var=kDmabufSystemUncachedHeapName",
        "--allowlist-type=BufferAllocator",
        "--allowlist-type=SyncType",
    ],
    min_sdk_version: "36",
    apex_available: [
        "com.android.npumanager",
    ],
}
